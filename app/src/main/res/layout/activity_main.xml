<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#001A33">

    <!-- Encabezado Arcade HUD TecNM -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎮 STAGE 5-26: AUTOMATED TESTING &amp; QA"
        android:textColor="#FF6600"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- CardView de Entrada y Control de Pruebas -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#002244"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 PANEL DE EJECUCIÓN DE PRUEBAS"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEntradaModulo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Ingrese nombre del módulo a probar..."
                android:textColorHint="#8A7E72"
                android:textColor="#FFFFFF"
                android:background="#001122"
                android:padding="10dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnValidarModulo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="EJECUTAR PRUEBA DE INTEGRACIÓN"
                android:backgroundTint="#FF6600"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tvResultadoValidacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Listo para ejecutar pruebas."
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Lista RecyclerView de Módulos Evaluados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvModulosTest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>