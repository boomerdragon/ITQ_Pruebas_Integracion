<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#002244">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvNombreModuloItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MÓDULO DE PRUEBA"
            android:textColor="#FFD700"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCoberturaItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cobertura: 90%"
            android:textColor="#D0D8E0"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvEstadoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VALIDADO"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#001122"
            android:padding="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>